        "description": "Search Lithuanian acts whose title contains a substring.",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "contains": {
              "description": "substring matched against the act title (Lithuanian ``pavadinimas``).",
              "type": "string"
