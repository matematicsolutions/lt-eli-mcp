            "doc_type": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "optional Lithuanian act type (``rusis``), e.g. ``\"Istatymas\"`` (law),\n``\"Isakymas\"`` (order). Match the exact Lithuanian spelling."
            },
            "limit": {
              "default": 50,
              "description": "max hits (1..200, default 50).",
              "type": "integer"
            }
          },
          "required": [
