                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "tar_kodas": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "title": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "validity": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            }
          },
          "type": "object"
        }
      },
      "sha256": "b8374095ed37643c6e8456ebf6bd51c86fce6300c077ff6cb2470178f47c8f8f"
